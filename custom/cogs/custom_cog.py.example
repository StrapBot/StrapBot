# NOTE: if you're making a guild extension, you have
#       to use the guild_extension.py file instead.

import discord
from discord.ext import commands
from core.context import StrapContext


class MyCustomCog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.hybrid_command()
    async def hello(self, ctx: StrapContext):
        await ctx.send("Hello, world!\nFrom my new custom cog!")


async def setup(bot: commands.Bot):
    await bot.add_cog(MyCustomCog(bot))
